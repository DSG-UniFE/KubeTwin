#!/usr/bin/env python3

import csv
from pathlib import Path

import matplotlib.pyplot as plt
import numpy as np


ROOT = Path(__file__).resolve().parent.parent
comparison_csv = ROOT / "response_time_scenarios_comparison.csv"


def read_csv(path):
    with path.open() as f:
        return list(csv.DictReader(f))


def plot_main(rows):
    labels = [f"S{row['solution_id']}" for row in rows]
    testbed = [float(row["testbed_avg_ms"]) for row in rows]
    simulated = [float(row["simulated_mean_ms"]) for row in rows]

    x = np.arange(len(labels))
    width = 0.36

    fig, ax = plt.subplots(figsize=(9, 5))
    ax.bar(x - width / 2, testbed, width, label="Testbed avg")
    ax.bar(x + width / 2, simulated, width, label="Simulated mean")
    ax.set_title("Response Time Scenarios: Testbed vs Simulator")
    ax.set_ylabel("ms")
    ax.set_xticks(x)
    ax.set_xticklabels(labels)
    ax.legend()
    ax.grid(axis="y", alpha=0.2)
    fig.tight_layout()
    fig.savefig(ROOT / "response_time_scenarios_comparison.png", dpi=160)
    plt.close(fig)
def main():
    main_rows = read_csv(comparison_csv)
    plot_main(main_rows)
    print("Wrote response_time_scenarios_comparison.png")


if __name__ == "__main__":
    main()
