#!/usr/bin/env ruby

begin
  require 'kube_twin'
  require 'kube_twin/surrogate_analysis'
rescue LoadError
  require 'rubygems'
  require 'kube_twin'
  require 'kube_twin/surrogate_analysis'
end

def do_abort(message)
  abort <<-EOS.gsub(/^\s+\|/, '')
      |#{message}
      |
      |Usage:
      |    #{File.basename(__FILE__)} surrogate_bundle_file.bin
      |
      |Analyzes a surrogate model bundle saved by the surrogate optimizer.
      |Computes regression metrics, MDI and permutation feature importances,
      |and saves results to CSV files.
  EOS
end

case ARGV.size
when 0
  do_abort('Missing surrogate bundle file!')
end

bundle_path = ARGV[0]
do_abort("File not found: #{bundle_path}") unless File.exist?(bundle_path)

analysis = KUBETWIN::SurrogateAnalysis.new(bundle_path)
analysis.run

exit 0
