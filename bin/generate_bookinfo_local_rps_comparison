#!/usr/bin/env ruby

begin
  require 'kube_twin'
  require 'kube_twin/evaluation'
rescue LoadError
  require 'rubygems'
  require 'kube_twin'
  require 'kube_twin/evaluation'
end

require 'csv'
require 'logger'
require 'time'

# Same idea as bin/generate_bookinfo_rps_comparison, but for
# examples/bookinfo_with_limits_local_rps.conf, whose MDNs are trained on
# LOCAL RPS instead of nominal. Real testbed clients apparently pace
# themselves closed-loop (see
# OPTIMUUM-estensioni/bookinfo_with_limits/local_rps_diagnostic.py): at a
# "nominal" configured rate of 120 rps, the local (causal, 10s-window) rate
# actually observed at each microservice's arrival stream only ever
# averaged ~37 rps. KubeTwin's own request_gen is open-loop, so driving it
# at nominal=120 would make it genuinely experience ~120 rps - far outside
# this model's training range, and not what the real testbed at that label
# actually produced. So each nominal level here is driven at its measured
# local-RPS mean instead, while still comparing against the real e2e data
# recorded under that nominal label (the real ground truth doesn't change -
# only what rate the simulator is driven at to reproduce it fairly).

NOMINAL_TO_LOCAL_RPS = {
  1 => 0.45,
  10 => 3.93,
  20 => 7.72,
  30 => 11.01,
  40 => 14.51,
  50 => 17.55,
  60 => 20.68,
  70 => 25.26,
  80 => 26.82,
  90 => 29.34,
  100 => 32.78,
  110 => 33.91,
  120 => 37.37
}.freeze

def do_abort(message)
  abort <<~EOS
    #{message}

    Usage:
        #{File.basename(__FILE__)} real_e2e_csv [config]
  EOS
end

real_csv_path = ARGV[0] || '/Users/filippopoltronieri/Downloads/OPTIMUUM-estensioni/bookinfo_with_limits/bookinfo_e2e_productpage.csv'
config_path = ARGV[1] || 'examples/bookinfo_with_limits_local_rps.conf'

do_abort('Invalid real e2e csv path') unless File.exist?(real_csv_path)
do_abort('Invalid config path') unless File.exist?(config_path)

METRICS = %i[mean p50 p90 p95 p99].freeze

class BookinfoLocalRpsComparison
  def initialize(real_csv_path:, config_path:)
    @real_csv_path = real_csv_path
    @config_path = config_path
  end

  def run
    real_stats = load_real_stats
    comparisons = NOMINAL_TO_LOCAL_RPS.filter_map do |nominal_rps, local_rps|
      next unless real_stats[nominal_rps]

      compare_at_rps(nominal_rps, local_rps, real_stats[nominal_rps])
    end
    write_csv(comparisons)
    write_report(comparisons)
  end

  private

  def load_real_stats
    rows = CSV.read(@real_csv_path, headers: true)
    by_rps = Hash.new { |h, k| h[k] = [] }
    rows.each { |r| by_rps[r['nominal_rps'].to_i] << r['e2e_time_us'].to_f / 1000.0 } # -> ms

    by_rps.transform_values do |vals|
      sorted = vals.sort
      n = sorted.length
      {
        n: n,
        mean: sorted.sum / n,
        p50: sorted[(n * 0.50).to_i.clamp(0, n - 1)],
        p90: sorted[(n * 0.90).to_i.clamp(0, n - 1)],
        p95: sorted[(n * 0.95).to_i.clamp(0, n - 1)],
        p99: sorted[(n * 0.99).to_i.clamp(0, n - 1)]
      }
    end
  end

  def compare_at_rps(nominal_rps, local_rps, real)
    conf = KUBETWIN::Configuration.load_from_file(@config_path)
    conf.set_rgen(nil, {
                    1 => {
                      workflow_types: 1,
                      starting_time: conf.start_time,
                      request_distribution: { distribution: :exponential, args: { rate: local_rps, seed: conf.seed } },
                      num_requests: 10_000,
                      num_customers: 1
                    }
                  })

    null_logger = Logger.new(File::NULL)
    sim = KUBETWIN::KSimulation.new(configuration: conf,
                                    evaluator: KUBETWIN::Evaluator.new(conf),
                                    logger: null_logger,
                                    log_level: Logger::FATAL)
    original_stdout = $stdout
    $stdout = File.open(File::NULL, 'w')
    metrics = sim.evaluate_allocation_multiobjective
    $stdout.close
    $stdout = original_stdout

    sim_ms = METRICS.to_h { |m| [m, metrics[:"#{m}_ttr"] * 1000.0] }

    result = { nominal_rps: nominal_rps, local_rps: local_rps, real_n: real[:n] }
    METRICS.each do |m|
      result[:"real_#{m}"] = real[m]
      result[:"sim_#{m}"] = sim_ms[m]
      result[:"delta_#{m}_pct"] = pct_delta(sim_ms[m], real[m])
    end
    result
  end

  def pct_delta(simulated, real)
    return nil if real.nil? || real.zero?

    ((simulated - real) / real) * 100.0
  end

  def write_csv(comparisons)
    path = 'bookinfo_local_rps_comparison.csv'
    File.open(path, 'w') do |f|
      header = %w[nominal_rps local_rps real_n]
      METRICS.each { |m| header += ["real_#{m}", "sim_#{m}", "delta_#{m}_pct"] }
      f.puts header.join(',')
      comparisons.each do |row|
        values = [row[:nominal_rps], row[:local_rps], row[:real_n]]
        METRICS.each { |m| values += [row[:"real_#{m}"], row[:"sim_#{m}"], row[:"delta_#{m}_pct"]] }
        f.puts values.join(',')
      end
    end
    puts "Wrote #{path}"
  end

  def write_report(comparisons)
    path = 'bookinfo_local_rps_comparison.md'
    File.open(path, 'w') do |f|
      f.puts '# Bookinfo (local-RPS-conditioned MDN) comparison: simulator vs real'
      f.puts
      f.puts "Generated at: `#{Time.now.utc.iso8601}`"
      f.puts
      f.puts "Config: `#{@config_path}`"
      f.puts
      f.puts "Real end-to-end productpage response times from: `#{@real_csv_path}`"
      f.puts
      f.puts 'Simulator driven at each level\'s measured *local* RPS (open-loop simulator matching what the real, closed-loop-paced client actually produced), not the nominal label.'
      f.puts
      f.puts '| nominal RPS | local RPS | n (real) | real mean | sim mean | Δ% | real p50 | sim p50 | Δ% | real p90 | sim p90 | Δ% | real p95 | sim p95 | Δ% | real p99 | sim p99 | Δ% |'
      f.puts '| --- | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: | ---: |'
      comparisons.each do |row|
        cells = [row[:nominal_rps], row[:local_rps], row[:real_n]]
        METRICS.each { |m| cells += [fmt(row[:"real_#{m}"]), fmt(row[:"sim_#{m}"]), fmt(row[:"delta_#{m}_pct"])] }
        f.puts "| #{cells.join(' | ')} |"
      end
      f.puts
      f.puts "## Summary (mean |Δ%| across all #{comparisons.length} RPS levels)"
      f.puts
      METRICS.each do |m|
        vals = comparisons.map { |r| r[:"delta_#{m}_pct"] }.compact
        mae = vals.sum(&:abs) / vals.length
        f.puts "- #{m.to_s.upcase}: #{mae.round(2)}%"
      end
    end
    puts "Wrote #{path}"
  end

  def fmt(value)
    return '-' if value.nil?

    value.round(2)
  end
end

BookinfoLocalRpsComparison.new(real_csv_path: real_csv_path, config_path: config_path).run
