#!/usr/bin/env ruby

begin
  require 'kube_twin'
  require 'kube_twin/evaluation'
rescue LoadError
  require 'rubygems'
  require 'kube_twin'
  require 'kube_twin/evaluation'
end


def do_abort(message)
  abort <<-EOS.gsub(/^\s+\|/, '')
    |#{message}
    |
    |Usage:
    |    #{File.basename(__FILE__)} simulator_config_file [allocation_json] [solution_id]
    |
  EOS
end


if File.expand_path(__FILE__) == File.expand_path($0)
  # make sure both required arguments were given
  case ARGV.size
  when 0 then
    do_abort("Missing simulator configuration files!")
  end

  # make sure simulator config file exists
  unless File.exist? ARGV[0]
    do_abort("Invalid simulator configuration file!")
  end

  # load simulation configuration
  conf = KUBETWIN::Configuration.load_from_file(ARGV[0])

  # create a simulator and launch it
  sim = KUBETWIN::KSimulation.new(configuration: conf,
                               evaluator: KUBETWIN::Evaluator.new(conf))

  if ARGV[1]
    unless File.exist? ARGV[1]
      do_abort('Invalid allocation JSON file!')
    end

    replay = KUBETWIN::AllocationReplay.new(conf)
    rss, replicas_mapping = replay.load_from_file(ARGV[1], solution_id: ARGV[2])
    res = sim.evaluate_allocation(rss, nil, nil, nil, nil, replicas_mapping)
  else
    res = sim.evaluate_allocation
  end

  # Print results
  puts 'Result:'
  puts res
end
